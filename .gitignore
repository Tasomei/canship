# `npm config set` without --location=global, and a scoped `npm login`, write a
# project-level .npmrc — and what they write is an auth token. The user-level
# file lives outside any repository; this one would live inside this one.
.npmrc

# Local scratch space for one-off scripts and throwaway repros.
.scratch/
canship-report.html

# The .env files under test/fixtures are committed on purpose: they are test
# fixtures full of fake keys, used to verify the rules fire correctly.
# Do not let the patterns below swallow them.
.env
.env.local
.env.*.local
!test/fixtures/**/.env*
