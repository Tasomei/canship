# Correct: no public prefix, stays on the server, must not be reported
OPENAI_API_KEY=sk-proj-T3blbkFJmN9xQ2vRs7WcYzApLd4EgHiKuo

# Fatal, and previously invisible: a trailing comment used to stay glued to the
# value, so it matched no known key format and the line was reported as nothing.
# People annotate exactly the variables that matter, which is what made this bad.
