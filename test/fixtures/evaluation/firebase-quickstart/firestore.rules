// 改编自 Firebase 官方示例；仅翻译注释，规则不变。
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurants/{restaurant} {
      match /ratings/{rating} {
        // 允许公开读取，仅已登录用户可写入。
        allow read: if true;
        allow write: if request.auth != null;
      }

      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
