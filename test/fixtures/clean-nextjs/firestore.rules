// Test fixture: correctly scoped Firebase rules. Nothing here should be reported.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Correct: ownership check.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Correct: deliberately public data, but read-only.
    match /announcements/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Correct: signed-in users only.
    match /comments/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
  }

    // Left behind after tightening this rule. A comment is not a rule — but a
    // certain-confidence "your database is wide open" used to come out of one.
    // allow read, write: if true;
}
