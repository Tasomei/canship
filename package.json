{
  "name": "canship",
  "version": "0.8.0",
  "description": "Static scanner for credentials, access rules and unsafe request input in JS/TS apps. Offline file scans; deployment probes require separate confirmation.",
  "keywords": [
    "security",
    "audit",
    "secrets",
    "api-key",
    "supabase",
    "nextjs",
    "express",
    "hono",
    "fastify",
    "vibe-coding",
    "ai-generated-code",
    "static-analysis",
    "cli"
  ],
  "homepage": "https://github.com/Tasomei/canship#readme",
  "bugs": {
    "url": "https://github.com/Tasomei/canship/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tasomei/canship.git"
  },
  "author": "Tasomei",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schemas/scan-report-v1.schema.json": "./schemas/scan-report-v1.schema.json",
    "./schemas/config-v1.schema.json": "./schemas/config-v1.schema.json",
    "./dist/cli.js": "./dist/cli.js"
  },
  "bin": {
    "canship": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "README-zh-CN.md",
    "docs/reference.md",
    "docs/reference-zh-CN.md",
    "docs/framework-support.md",
    "docs/framework-support-zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && npm --prefix tools/vsix ci --ignore-scripts --no-audit --no-fund && node scripts/package-extension.mjs",
    "test:extension-package": "npm run build:extension && npm --prefix tools/vsix ci --ignore-scripts --no-audit --no-fund && node --test tools/vsix/test/package.test.mjs",
    "benchmark": "npm run build && node --max-old-space-size=256 scripts/benchmark.mjs",
    "demo": "tsx scripts/render-demo.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:projects": "tsx scripts/evaluate-projects.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.95.0",
    "ajv": "^8.20.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
